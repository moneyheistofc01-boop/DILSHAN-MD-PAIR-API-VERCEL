# Exact Cloudflare Pages origin (no trailing slash)
CORS_ORIGIN=https://dilshan-pairsite.pages.dev

# MongoDB Atlas connection string. Keep this secret.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=dilshan_md

# Use the SAME secret on the bot host. Must be at least 32 characters.
SESSION_LOOKUP_SECRET=replace-with-a-unique-random-secret-of-32-or-more-characters
